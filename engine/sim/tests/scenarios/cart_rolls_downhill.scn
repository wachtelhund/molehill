// A mine cart set on track that runs downhill rolls away on its own: gravity along the slope (1 in 4) pulls
// it, it picks up speed, runs out onto the level stretch at the bottom and is slowed by rolling friction, and
// stops dead at the end of the track (the bumper), where it stays on the rails.
map
############################################################
#..........................................................#
#..........................................................#
#..........................................................#
#.@........................................................#
#######====................................................#
#......####====............................................#
#......########====........................................#
#......############====....................................#
#......################====................................#
#......####################====............................#
#......########################====........................#
#......############################====....................#
#......################################====................#
#......####################################====............#
#......########################################========#####
#......#####################################################
#......#####################################################
#......#####################################################
############################################################
end
give Cart 1
place 2 7 1 Cart                  // on the track, 1.25 m down the slope
expect 3 carts == 1
expect 3 cartrail == 1
expect 30 cartv > 2               // half a second later it is rolling downhill (tiles/s)
expect 60 cartx > 10              // and on its way (about 1.4 m/s² down a 1-in-4 slope less rolling friction)
expect 120 cartv > 8              // faster at the bottom of the slope
expect 400 cartv == 0             // come to rest...
expect 400 cartx > 46             // ...out on the level, at or short of the end of the track
expect 400 cartx < 54
expect 400 cartrail == 1
