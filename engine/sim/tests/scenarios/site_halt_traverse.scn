end
site 1 halt -92 -67
give RopeGun 1
give HookRope 40
fireby 2 -1 -40
hold 2-26 left
hold 27-191 left up
hold 192-195 left jump
hold 196-201 left
fireby 202 -1 -40
hold 202-226 left
hold 227-391 left up
hold 392-395 left jump
hold 396-401 left
fireby 402 -1 -40
hold 402-426 left
hold 427-591 left up
hold 592-595 left jump
hold 596-601 left
fireby 602 -1 -40
hold 602-626 left
hold 627-791 left up
hold 792-795 left jump
hold 796-801 left
fireby 802 -1 -40
hold 802-826 left
hold 827-991 left up
hold 992-995 left jump
hold 996-1001 left
fireby 1002 -1 -40
hold 1002-1026 left
hold 1027-1191 left up
hold 1192-1195 left jump
hold 1196-1201 left
fireby 1202 -1 -40
hold 1202-1226 left
hold 1227-1391 left up
hold 1392-1395 left jump
hold 1396-1401 left
hold 1401-1404 jump                 // off the last rope at the west wall
hold 1405-1470 right                // back east to the chest
expect 1540 chests == 1             // the site chest, opened
expect 1540 hp == 100               // no fall: every rope climbed, every drop off a stack short
