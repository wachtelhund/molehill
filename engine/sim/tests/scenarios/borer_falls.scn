end
give SteamBorer 1
give Coal 3
hold 1-1 left                         // face west
place 2 -5 0 SteamBorer
wield 10 Coal
use 11 -5 -2
use 12 -5 -2
wield 13 none
use 14 -5 -2
expect 15 onborer == 1
expect 290 borery == 8                // on the ledge
expect 3 static:Granite == 1216
hold 300-400 left                     // off the ledge's end (at 31)
expect 400 borerx < 31
expect 400 borery > 28                // fell into the pit
expect 400 onborer == 1               // the mole rode it down
expect 600 borery < 32                // resting on the pit floor (at 35: its head 3 tiles round)
expect 600 borery > 31
expect 600 static:Granite == 1216     // it cut nothing
