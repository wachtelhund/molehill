give RopeLadder 1
give Lift 1
give RopeGun 1
give HookRope 1
place 4 2 -6 RopeLadder
place 6 8 -3 Lift
fire 8 10 -21
expect 60 ladders == 1
expect 60 lifts == 1
expect 60 ropes == 1
expect 60 stops == 2
slide 62
expect 64 ladders == 1
expect 64 lifts == 1
expect 64 ropes == 1
saveload 66
slide 68
