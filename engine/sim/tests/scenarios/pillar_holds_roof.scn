// Placed wood pillars are rigid: a full pillar under the roof and a short free-standing stub
// in a wide room both stay put (no tributary roof load on a stub that doesn't touch the roof).
map
#################################
#################################
#...............................#
#...............................#
#...............................#
#...............................#
#...............................#
#...............................#
#...............@...............#
#################################
#################################
end
give WoodPillar 20
// full pillar 6 right of the mole, floor to roof (7 cells)
place 2 6 0 WoodPillar
place 3 6 -1 WoodPillar
place 4 6 -2 WoodPillar
place 5 6 -3 WoodPillar
place 6 6 -4 WoodPillar
place 7 6 -5 WoodPillar
place 8 6 -6 WoodPillar
// a 3-cell stub 6 left of the mole, not touching the roof
place 10 -6 0 WoodPillar
place 11 -6 -1 WoodPillar
place 12 -6 -2 WoodPillar
// a ledge: two pillar cells sticking out of the left wall at mid height
place 14 -15 -3 WoodPillar
place 15 -14 -3 WoodPillar
expect 20 count:WoodBeam == 12
expect 600 static:WoodBeam == 12
expect 600 is:6,-6,WoodBeam == 1
expect 600 is:-6,-2,WoodBeam == 1
expect 600 is:-14,-3,WoodBeam == 1
