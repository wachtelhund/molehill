end
give SteamBorer 1
give CoalWagon 1
give StoreWagon 1
give Coal 8
hold 1-1 right                        // face right: the borer heads the way the mole faces
place 2 8 0 SteamBorer
place 3 -2 0 StoreWagon               // its first segment: couples on
place 4 -7 0 CoalWagon                // its second: couples on behind it
expect 8 train == 2
expect 8 log:couples == 2
expect 8 wagony == 8                  // set on the borer's path, at its head's height
wield 10 Coal
use 11 -7 -3                          // shovel the coal into the coal wagon
expect 12 inv:Coal == 0
expect 12 borerfuel >= 1              // the stoking chute fed the firebox
wield 210 none
use 211 8 -2                          // climb into the cab
expect 212 onborer == 1
hold 320-700 right                    // through the ore and into the granite
expect 700 borerx > 60
expect 700 train == 2
expect 700 wagonx > 60                // the store wagon followed it in, 10 tiles behind the head
expect 700 wagonload >= 3             // the iron ore off its sieve
expect 700 count:Gravel < 1           // no rubble left behind
hold 701-900 down                     // round and down: the train follows the curve
expect 900 borery > 30
expect 900 wagony > 20                // the store wagon is down the shaft after it...
expect 900 wagonx > 75                // ...having come round the bend
expect 900 train == 2
hold 905-907 jump
saveload 910
expect 911 train == 2
expect 911 wagonload >= 3
expect 911 wagony > 20
