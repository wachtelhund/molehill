// A boiler needs water. The same boiler and engine with the sump dry: the coal burns (and its ash comes out),
// but there's nothing to boil, so no steam rises and the belt the engine drives stays still.
map
########################################
########################################
########################################
########################################
########################################
########################################
########################################
########################################
#........EE*jjjjjjjjjjjj*..............#
######..................j..............#
#.......................j..............#
#.......................j..............#
#.......................j..............#
#...................@...*>>>>>>>>>>>...#
########################################
########################################
end
give Boiler 1
place 2 -11 -2 Boiler
drop 10 Coal -13 -6
expect 300 bburning == 1
expect 300 bwater == 0
expect 300 bsteam == 0
expect 300 turning:5,0 == 0
expect 2600 items:Ash == 1            // it burnt all the same
expect 2600 bsteam == 0
