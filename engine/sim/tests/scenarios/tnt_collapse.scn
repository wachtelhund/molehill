// A blast in a sand-capped rock block: most of the rock is broken and thrown, and the sand cap comes down
// with it. What's left is a heap of rubble and sand on the floor, not a capped block.
map
##############################
#............................#
#............................#
#............................#
#..........sssssssssss.......#
#..........rrrrrrrrrrr.......#
#..........rrrrrrrrrrr.......#
#..........rrrrrrrrrrr.......#
#.@........rrrrrrrrrrr.......#
##############################
end
expect 0 count:Rock == 44
expect 0 count:Sand == 11
explode 5 15 -2 0.2
expect 6 is:15,-2,Rock == 0
expect 6 count:Rock < 20
expect 200 is:9,-4,Sand == 0     // the cap's two ends have come down
expect 200 is:19,-4,Sand == 0
expect 200 debris == 0           // everything thrown has landed
