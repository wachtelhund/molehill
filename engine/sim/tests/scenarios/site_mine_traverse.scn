end
site 1 mine -200 -83
hold 2-40 left
hold 20-24 jump                   // jump at the post and cling
hold 24-280 up left               // climb the post, then the rope
hold 285-320 jump                 // a full jump off the rope's top
hold 285-330 right
expect 3 ladders == 1
expect 80 cling == -1             // on the post
expect 100 climbing == 1          // handed onto the rope
expect 275 py < 41               // at the rope's top
expect 275 vy == 0                // hanging still there
expect 330 grounded == 1          // on the upper heading's floor
expect 330 py < 40.1
expect 330 px > 205
expect 330 hp == 100
