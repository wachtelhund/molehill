end
site 1 crystal 4 -59
hold 2-600 right
hold 30-38 jump
hold 70-78 jump
hold 110-118 jump
hold 150-158 jump
hold 190-198 jump
hold 230-238 jump
hold 270-278 jump
hold 310-318 jump
hold 350-358 jump
hold 390-398 jump
hold 430-438 jump
hold 470-478 jump
hold 510-518 jump
hold 550-558 jump
expect 120 px > 20               // in the mouth
expect 600 chests == 1            // the site chest, opened
expect 600 hp == 100
