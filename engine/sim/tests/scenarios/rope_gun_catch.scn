end
give RopeGun 1
give HookRope 1
fire 5 0 -39
hold 60-200 up
expect 200 onrope == 1
expect 200 dy < -15
hold 201-204 jump
expect 206 onrope == 0
hold 215-240 up
expect 240 onrope == 1
expect 240 hp == 100
hold 241-400 down
expect 400 onrope == 0
expect 400 grounded == 1
expect 400 hp == 100
