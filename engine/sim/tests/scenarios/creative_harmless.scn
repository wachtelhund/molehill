end
mode creative
expect 1 inv:Tnt == 999
expect 1 inv:Bore == 999
lamp 1 on
set 2 hp 1
set 2 hunger 0
expect 3 hp == 100
expect 3 hunger == 100
// a 32-tile fall would hurt anyone else
hold 5-10 left
expect 120 deaths == 0
expect 120 hp == 100
expect 120 flash == 0
set 130 oil 0
expect 200 lamp == 1
