end
give RopeLadder 2
place 2 -3 -6 RopeLadder           // into the cliff: no
expect 3 ladders == 0
place 4 2 -6 RopeLadder            // 1 m out from the face
expect 5 ladders == 1
expect 5 ladderx == 12             // against the face (the cliff's last column is 11)
expect 5 laddertop == 5
expect 5 ladderlen == 18           // to the floor
hold 10-40 up                      // and it climbs as ever
expect 12 climbing == 1
