end
site 1 holt 4 -51
hold 2-250 right
hold 25-32 jump                   // over the first bedding pile
hold 190-200 jump                 // up onto the table
expect 60 px > 12                 // in through the west door
expect 250 px > 56                // on the table, at the chest (13 m in)
expect 250 px < 64
expect 250 py < 56.1
expect 250 grounded == 1
expect 250 hp == 100
