// "I found something I can't use yet": a seam the tools owned can't cut says so when it is first seen, and
// what to come back with ("Discovery: Iron ore at 2 m (+2 torches). Your pickaxe can't cut it: come back
// with a drill (bronze, made at a powered workshop)"). Digging at it refuses with the same advice, once per
// press. With a drill in the pack the same ore digs. The quest chain carries it: "Find iron ore" is done
// by seeing it and names the next step; after the drill, "Go back for the iron" is done by digging 4.
map
BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB
##################################################################iiiiiiiiiiiiii#
#.................................................................iiiiiiiiiiiiii#
#.................................................................iiiiiiiiiiiiii#
#.................................................................iiiiiiiiiiiiii#
#..@..............................................................iiiiiiiiiiiiii#
################################################################################
end
mode survival
undiscovered IronOre
tool 1 1
set 1 quest 13                      // "Find iron ore (your pickaxe can't cut it yet)"
expect 2 known:IronOre == 0
expect 2 log:discovery:_iron_ore == 0
// walk up to the seam: it is seen, and the find says what will open it
hold 3-260 right
expect 261 log:discovery:_iron_ore == 1
expect 261 log:your_pickaxe_can't_cut_it:_come_back_with_a_drill == 1
expect 261 quest == 14              // seen is enough: the quest moves on
expect 261 log:next:_build_a_workshop == 1
// dig at it: refused with the same advice
mine 270-290 64 -1
expect 291 log:iron_ore_is_too_hard_for_your_pickaxe:_come_back_with_a_drill == 1
expect 291 inv:IronOre == 0
// back with a drill: it digs
set 295 quest 16                    // "Go back for the iron: dig 4 iron ore"
set 295 inv:Drill 1
tool 296 2
mine 300-400 64 -1
mine 401-500 66 -2
mine 501-600 68 -1
mine 601-700 70 -2
expect 701 inv:IronOre >= 4
expect 701 quest == 17
expect 701 log:quest_complete:_go_back_for_the_iron == 1
