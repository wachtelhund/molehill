end
site 1 pump -195 -75
give RopeGun 1
give HookRope 2
hold 2-100 left                    // in by the service door, to the wheel's foot
hold 101-140 right                 // back into the gap between the wheel and the hall's east wall
fireby 145 0 -40                   // the hook goes straight up, 15 m, into the iron gallery under the roof
hold 220-510 up                    // W grabs (a fresh press, once the hook has bitten) and climbs above the wheel's top
hold 511-585 left                  // A pumps the swing west, over the wheel
hold 586-589 left jump             // let go at the top of the swing...
hold 590-660 left                  // ...and drops onto the wheel's west shoulder
expect 660 py < 50                 // up on the wheel
expect 660 grounded == 1
expect 660 hp == 100
