end
site 1 fissure -75 -95
hold 2-110 left
expect 30 py == 98                 // onto the bridge level with the mouth
expect 110 px < 60                 // out along the bridge
expect 110 py == 98
expect 110 grounded == 1
expect 700 py == 98                // still standing on it...
expect 700 hp == 100               // ...and nothing fell on it
expect 700 debris == 0
expect 700 deaths == 0
