end
give RopeGun 1
give HookRope 3
fire 10 14 -2
expect 60 ropes == 0
expect 60 hook == 0
expect 60 inv:HookRope == 2
expect 60 items:HookRope == 1
fire 70 -9 0
expect 120 ropes == 0
expect 120 items:HookRope == 2
fire 130 0 -30
expect 200 ropes == 1
expect 200 ropey < 1.6            // the hook sits on the ceiling's face (row 1 is the first open row)
expect 200 inv:HookRope == 0
saveload 220
hold 225-250 left             // out from under the ceiling before it is blown
expect 240 ropes == 1
explode 260 0 -30 1
expect 320 ropes == 0
expect 320 items:HookRope == 3
