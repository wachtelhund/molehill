// Four wood-pillar columns under the same clay roof (spans of 5-6 cells) keep it up; the pillars stay rigid.
map
################################
#cccccccccccccccccccccccccccccc#
#..............................#
#..............................#
#..............................#
#..............................#
#..............................#
#.@............................#
################################
end
give WoodPillar 40
put 1 5 0 WoodPillar
put 2 5 -1 WoodPillar
put 3 5 -2 WoodPillar
put 4 5 -3 WoodPillar
put 5 5 -4 WoodPillar
put 6 5 -5 WoodPillar
put 7 11 0 WoodPillar
put 8 11 -1 WoodPillar
put 9 11 -2 WoodPillar
put 10 11 -3 WoodPillar
put 11 11 -4 WoodPillar
put 12 11 -5 WoodPillar
put 13 17 0 WoodPillar
put 14 17 -1 WoodPillar
put 15 17 -2 WoodPillar
put 16 17 -3 WoodPillar
put 17 17 -4 WoodPillar
put 18 17 -5 WoodPillar
put 19 23 0 WoodPillar
put 20 23 -1 WoodPillar
put 21 23 -2 WoodPillar
put 22 23 -3 WoodPillar
put 23 23 -4 WoodPillar
put 24 23 -5 WoodPillar
expect 600 crumbled == 0
expect 600 count:WoodBeam == 24
expect 600 count:Clay == 30
