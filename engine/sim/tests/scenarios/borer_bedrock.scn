end
give SteamBorer 1
give Coal 3
hold 1-1 right
place 2 5 0 SteamBorer
wield 10 Coal
use 11 5 -2
use 12 5 -2
wield 13 none
use 14 5 -2
expect 15 onborer == 1
expect 3 count:Bedrock > 0
hold 300-500 right
expect 500 borerx < 12                // against the face at 14 (its head 3 tiles round)
expect 500 borerx > 11
expect 500 borerv == 0
expect 500 log:bedrock >= 1
hold 501-800 down
expect 800 borerang == 90
expect 800 borery > 30                // bored down past it
expect 800 borerx > 11                // sliding down its side
expect 800 borerx < 12
