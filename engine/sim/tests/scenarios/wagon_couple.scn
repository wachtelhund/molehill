// Coupling is physical, and a train comes apart from its tail. A store wagon set down where the borer's first segment
// rides couples on (clank), and a bunk wagon set down where the next one rides couples on behind it. E on the store
// wagon, in the middle, uncouples nothing ("Uncouple the wagons behind it first"); E on the bunk wagon, the last,
// uncouples it, and it stays loose where it is (it won't hook straight back on), so E again takes it up. The borer bores
// on a little; out of the cab, the bunk wagon set down again at the train's new tail couples on again; then E, E takes
// it up again.
map
############################################################
############################################################
############################################################
#..........................................................#
#..........................................................#
#..........................................................#
#..........................................................#
#..........................................................#
#..........................................................#
#..........................................................#
#...........@..............................................#
############################################################
############################################################
############################################################
############################################################
############################################################
end
give SteamBorer 1
give StoreWagon 1
give BunkWagon 1
give Coal 3
hold 1-1 right
place 2 8 0 SteamBorer
place 3 -2 0 StoreWagon               // where its first segment rides: couples on
place 4 -7 0 BunkWagon                // where the next rides: couples on behind it
expect 8 train == 2
expect 8 log:couples == 2
wield 10 Coal
use 11 8 -2
use 12 8 -2
use 13 8 -2
wield 14 none
pickup 20 -1 -2                       // E on the store wagon: not the last
expect 21 train == 2
expect 21 log:behind == 1
pickup 22 -6 -2                       // E on the bunk wagon: the last, uncoupled
expect 23 train == 1
expect 23 log:Uncoupled == 1
expect 60 train == 1                  // loose: it doesn't hook straight back on
pickup 62 -6 0                        // E: take it up
expect 63 wagons == 1
expect 63 inv:BunkWagon == 1
use 70 8 -2                           // climb in
hold 300-320 right                    // on a little
expect 330 borerx > 25
expect 330 train == 1
hold 335-337 jump                     // out
place 360 0 0 BunkWagon               // at the train's new tail: couples on again
expect 361 train == 2
expect 361 log:couples == 3
pickup 370 0 -2                       // E, E: uncouple it and take it up again
expect 371 train == 1
pickup 372 0 -2
expect 373 wagons == 1
expect 373 inv:BunkWagon == 1
