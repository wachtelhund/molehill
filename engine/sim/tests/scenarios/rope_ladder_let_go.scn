end
give RopeLadder 1
place 2 -1 -16 RopeLadder
hold 5-40 up                      // up the rope
expect 50 climbing == 1
expect 50 vy == 0                 // hanging still
hold 60-70 right
expect 62 climbing == 0           // let go at once
expect 66 vx > 10                 // and moving at run speed (tiles/s)
hold 80-95 left                   // back under the rope
hold 96-140 up                    // and grab it again as it passes
expect 140 climbing == 1
hold 150 jump
expect 152 climbing == 0          // a jump lets go
expect 152 vy < 0                 // and it's a real jump off the rope
expect 260 hp == 100
