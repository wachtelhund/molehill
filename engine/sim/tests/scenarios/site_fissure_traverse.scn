end
site 1 fissure -75 -95
hold 2-158 left
expect 60 py > 99.9               // in the mouth
expect 150 py < 96.1              // up on the rubble
expect 180 grounded == 1          // down on the timber bridge by the gap
expect 180 py > 99
expect 180 px < 48
expect 180 hp == 100
