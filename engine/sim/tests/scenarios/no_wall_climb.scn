end
hold 1-120 right up jump
expect 30 cling == 0
expect 60 cling == 0
expect 120 rise < 6.5          // highest the feet got (tiles above the start)
expect 120 grounded == 1
hold 121-150 left jump
hold 151-180 right jump
hold 181-210 left jump
hold 211-240 right jump
expect 240 rise < 6.5
hold 241-300
expect 300 grounded == 1
expect 300 dy == 0
expect 300 hp == 100
