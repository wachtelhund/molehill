end
site 1 pump -195 -75
give RopeGun 1
give HookRope 2
hold 2-100 left                    // in by the service door, to the wheel's foot
hold 101-140 right                 // back into the gap between the wheel and the hall's east wall
fireby 145 0 -40                   // the hook goes straight up, 15 m, into the iron gallery under the roof
hold 220-510 up                    // W grabs (a fresh press, once the hook has bitten) and climbs above the wheel's top
hold 511-585 left                  // A pumps the swing west, over the wheel
hold 586-589 left jump             // let go at the top of the swing...
hold 590-730 left                  // ...onto the wheel's west shoulder, and on down onto the landing
hold 735-925 down
hold 935-1065 left
expect 700 py == 56                // stepped down onto the landing...
expect 700 hp == 100               // ...without a fall
expect 732 ladder_down == 1        // at the rope ladder's head: S takes the rope
expect 760 climbing == 1
expect 865 py == 84                // at the foot, on the dry hall floor
expect 865 chests == 1             // the chest is opened
expect 1065 hp == 100
