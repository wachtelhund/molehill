end
site 1 pump -195 -75
hold 2-500 left up
hold 30-38 jump
hold 70-78 jump
hold 110-118 jump
hold 150-158 jump
hold 190-198 jump
hold 230-238 jump
hold 270-278 jump
hold 310-318 jump
hold 350-358 jump
hold 390-398 jump
hold 430-438 jump
hold 470-478 jump
hold 501-667 left
hold 670-860 down
hold 870-1000 left
expect 500 py < 50                // up on the wheel
expect 640 py == 56               // stepped down onto the landing...
expect 640 hp == 100              // ...without a fall
expect 666 ladder_down == 1       // at the rope's head: S takes the rope
expect 700 climbing == 1
expect 800 py == 84               // at the foot, on the dry hall floor
expect 800 chests == 1            // the chest is opened
expect 1000 hp == 100             // the whole way unhurt
expect 1000 deaths == 0
