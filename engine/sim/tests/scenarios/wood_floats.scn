expect 300 is:4,-9,WoodBeam == 1  // wood debris at the surface
expect 300 static:WoodBeam == 0
expect 300 count:WoodBeam == 6
expect 300 count:Rock == 0
expect 300 is:18,-4,Sand == 1     // rock debris on the bottom
