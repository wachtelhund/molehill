loosen 1 21 -4                            // the blast's rubble is loose (sand is loose already)
loosen 1 24 -4
loosen 1 25 -3
loosen 1 26 -3
loosen 1 28 -3
expect 2 cells:Sand,16,36,-13,0 == 3
expect 2 cells:Gravel,16,36,-13,0 == 2
expect 400 cells:Sand,37,63,-4,15 == 3     // the sand and gravel washed into the pond
expect 400 cells:Gravel,37,63,-4,15 == 2
expect 400 cells:Sand,16,36,-13,0 == 0
expect 400 cells:Gravel,16,36,-13,0 == 0
expect 400 cells:IronOre,20,28,-6,0 == 3   // the ore where it lay (within a tile)
expect 400 cells:IronOre,37,63,-4,15 == 0
expect 400 count:Water == 200
