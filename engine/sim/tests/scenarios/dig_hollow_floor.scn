mode survival
nohunger
dig 3-120 0 2
expect 121 log:rings_hollow == 1
expect 121 hp == 100
expect 121 grounded == 1
expect 121 dy == 0
dig 130-160 0 2
expect 161 log:rings_hollow == 1
dig 170-400 6 2
expect 401 is:6,2,Rock == 0
expect 401 hp == 100
expect 401 dy == 0
