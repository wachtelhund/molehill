##########
end
expect 0 clues_bands:-7,-4 >= 24      // 96-224 m above the start: dense
expect 0 clues_bands:-1,0 >= 1         // around the start: a few
expect 0 clues_bands:-1,0 <= 6
expect 0 clues_bands:4,7 <= 2          // 128-256 m below: almost none
