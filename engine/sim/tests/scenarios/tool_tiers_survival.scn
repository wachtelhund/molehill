// Survival: you dig with the best tool you own, whatever is in hand. Claws take dirt and, slowly, soft stone
// (sandstone, limestone) so the first pickaxe can be made; the Pickaxe (tier 1) digs those faster; the Drill (tier 2) granite and iron ore; the Bore (tier 3) basalt.
// Each tool is picked up off the floor here, as it would come from a station or a chest. The basalt sits
// in basalt, so digging round it can't drop it out.
map
BBBBBBBBBBBBBBBBBBBBBBBBBBBBBB
#............................#
#............................#
#............................#
#............................#
#.....@...d...r...#...a......#
#####################aaa######
#####################aaa######
end
mode 1 survival
tool 1 3
brush 1 0.6
expect 2 tier == 0
mine 3-60 4 0
mine 61-120 8 0
expect 121 is:4,0,Dirt == 0            // claws take dirt
expect 121 is:8,0,Rock == 0            // and soft stone, slowly (so the first pickaxe's stone can be dug)
mine 121-160 12 0
expect 161 is:12,0,Granite == 1        // not granite
drop 162 Pickaxe 0 -1
expect 170 tier == 1
mine 201-260 12 0
expect 261 is:12,0,Granite == 1        // granite needs the drill
drop 262 Drill 0 -1
expect 270 tier == 2
mine 271-340 12 0
mine 341-400 16 0
expect 401 is:12,0,Granite == 0
expect 401 is:16,0,Basalt == 1         // basalt needs the bore
drop 402 Bore 0 -1
expect 410 tier == 3
mine 411-500 16 0
expect 501 is:16,0,Basalt == 0
