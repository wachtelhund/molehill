end
give RopeLadder 1
place 2 1 2 RopeLadder            // below the lip: it ties on at the lip and hangs to the floor
expect 3 ladders == 1
expect 3 ladder_down == 1         // S here climbs down (the game doesn't dig)
expect 3 ladder_up == 0           // W here jumps: the mole is on the ledge, not on the rope
hold 5-200 down
expect 8 climbing == 1            // onto the rope at once
expect 8 px > 12                  // over the rope, clear of the cliff face
expect 60 climbing == 1
expect 60 py > 15                 // on the way down...
expect 60 py < 30                 // ...at the rope's pace
expect 160 grounded == 1
expect 160 py > 35                // at the foot
expect 160 hp == 100              // no fall damage
