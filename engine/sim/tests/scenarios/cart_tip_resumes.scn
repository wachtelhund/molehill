// A cart saved while it tips at a bumper finishes tipping once it's loaded back (the tip itself isn't saved:
// a loaded cart standing against a bumper tips). Before the fix it came back with 17 stones that never came out.
map
############################################################
#..........................................................#
#..........................................................#
#..........................................................#
#.@........................................................#
#######====................................................#
#......####====............................................#
#......########====........................................#
#......############====............|.......................#
#......################============|.......................#
#......############################.......................##
#......############################.......................##
#......############################.......................##
#......############################.......................##
############################################################
end
give Cart 1
place 2 7 1 Cart
load 3 20 Stone
expect 189 tips == 1              // tipping when the save is taken...
expect 189 cargo < 20
expect 189 cargo > 10
saveload 190
expect 191 carts == 1
expect 400 cargo == 0             // ...and done after loading back
expect 400 items:Stone == 20
expect 400 cartrail == 1
