end
give Tnt 1
device 3 -3 -1 Lever
wire 4 1 -1 13 -1
device 5 16 -1 Tnt
expect 60 ev:Explode == 0
expect 60 dev:16,-1,Tnt == 1
use 61 -3 -1
expect 64 ev:Explode == 1
expect 64 dev:16,-1,Tnt == 0
