// A stream of sand pours from a hopper's slot past a corridor into a 3 m pit (Hampus's playtest, 2026-11-06).
// Grains in flight are not a wall or a floor: the mole jumps into the stream pressing into it and W, and gets
// no cling and no footing from it (it used to stand on it and stick there for good), so it drops through into
// the pit; from there it climbs the pit's rock wall and walks out the far side. Settled grains (the pile in the
// pit) carry the mole as before, and the pour passing through it does no harm.
map
############################################
#................#ssssss#..................#
#................#ssssss#..................#
#................#ssssss#..................#
#................#ssssss#..................#
#................#ssssss#..................#
#................#ssssss#..................#
#................#ssssss#..................#
#................#ssssss#..................#
#................#ssssss#..................#
#................###..###..................#
#..........................................#
#..........................................#
#..........................................#
#..........................................#
#..........................................#
#..........................................#
#..........................................#
#..........................................#
#..........................................#
#..........................................#
#..........................................#
#..........................................#
#..........................................#
#..........................................#
#..........................................#
#.......@..................................#
##################......####################
##################......####################
##################......####################
##################......####################
##################......####################
##################......####################
##################......####################
##################......####################
##################......####################
##################......####################
##################......####################
##################......####################
############################################
############################################
############################################
end
hold 2-60 right                   // run at the stream
hold 24-28 jump                   // and jump into it while it falls
hold 28-120 up right              // pressing into it and up, as onto a wall
expect 40 cling == 0
expect 50 cling == 0
expect 50 py > 26.9               // no footing on falling sand: through and down into the pit
expect 100 hp == 100              // and sand pouring past or onto it is no burial
hold 121-320 right                // out of the pit, and on
hold 125-130 jump                 // up over its 0.75 m rim
expect 320 px > 25                // out the other side
expect 320 py < 27.1
expect 320 hp == 100
