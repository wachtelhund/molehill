end
give RopeLadder 1
place 2 -1 -16 RopeLadder
expect 3 ladders == 1
expect 4 ladder_up == 1           // W here grabs the rope
expect 4 ladder_down == 0         // S at the foot digs as usual: no rope below the feet
hold 5-200 up
expect 7 climbing == 1
expect 45 py < 30                 // 40 ticks at 12 tiles/s: 8 tiles up
expect 45 py > 27
expect 130 grounded == 1          // off the top onto the ledge (18 tiles in 1.5 s)
expect 130 py < 19.1
expect 130 px < 12
expect 200 grounded == 1          // and still there with W held
expect 200 py < 19.1
expect 200 climbing == 0
expect 200 hp == 100
