// Fuel for light says so on the message line, briefly, when it matters. With no oil spare (no fungus oil in
// the pack, under 2 fungus to press) the headlamp warns once half a minute before it goes dark, then says it
// is out and what to gather; a torch that can't be lit says it needs oil (not "needs open space"); fungus
// found relights the lamp and says so. With oil spare it never warns.
map
##############################
#............................#
#............................#
#.@..........................#
##############################
end
mode survival
give FungusOil 0
lamp 1 on
set 2 oil 31                      // a second over the warning, none spare
expect 30 log:Headlamp_oil_low == 0
expect 100 log:Headlamp_oil_low == 1
expect 300 log:Headlamp_oil_low == 1     // once, not every tick
set 400 oil 0.5
expect 460 lamp == 0
expect 460 log:out_of_oil == 1
expect 460 log:2_press_into_a_measure == 1
placetorch 470 3 -1
expect 471 inv:Torch == 4
expect 471 log:needs_fungus_oil == 1
expect 471 log:in_the_way == 0
drop 480 Fungus 0 -1              // fungus turns up: it's pressed and the lamp relights
drop 480 Fungus 0 -1
expect 540 lamp == 1
expect 540 log:Headlamp_relit == 1
expect 540 oil > 170
drop 560 Fungus 0 -1              // and with oil spare it doesn't warn, however low it gets
drop 560 Fungus 0 -1
set 600 oil 20
expect 700 log:Headlamp_oil_low == 1
expect 700 lamp == 1
