end
give WoodPillar 10
place 5 8 0 WoodPillar
place 6 8 -1 WoodPillar
place 7 8 -2 WoodPillar
expect 10 count:WoodBeam == 3
expect 300 is:8,-2,WoodBeam == 1
expect 300 crumbled == 0
