end
give RopeLadder 1
place 40 8 -16 RopeLadder         // walked into the shaft first: hung from its ceiling
expect 41 ladders == 1
hold 5-30 right
hold 45-200 up
expect 60 climbing == 1           // grabbed at the foot
expect 195 py < 9.5               // at the top, under the ceiling
expect 195 vy == 0                // hanging still there
hold 200-260 right up             // off sideways into the side passage
expect 215 vx > 7.9               // 2 m/s along the rope (tiles/s)
expect 250 grounded == 1
expect 250 px > 20                // in the side passage
expect 250 py < 12.1
expect 260 hp == 100
