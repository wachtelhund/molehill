// Survival with hunger off (the New Holt / Settings option): food never drains, so the Delver never eats
// from the pack and never starves, while the rest of Survival still applies. The option is kept in the save.
map
##############################
#............................#
#............................#
#............................#
#............................#
#..@.........................#
##############################
end
mode survival
nohunger
expect 1 hungeron == 0
// a long stretch: the belly stays full and the food stays in the pack
expect 3000 hunger == 100
expect 3000 inv:Grub == 3
expect 3000 inv:Root == 2
expect 3000 hp == 100
// Survival's other rules still hold (the kit, owned tools)
expect 3000 inv:Pickaxe == 1
saveload 3010
expect 3011 hungeron == 0
expect 3011 mode == 1
expect 4000 hunger == 100
