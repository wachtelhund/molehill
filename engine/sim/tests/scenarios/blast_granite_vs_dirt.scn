// A charge between a dirt wall and a granite wall, the same distance from each: the dirt is blown out and
// cracked to rubble for a metre or more, the granite takes it.
map
############################
#dddddddddd.....############
#dddddddddd.....############
#dddddddddd.....############
#dddddddddd.....############
#dddddddddd.....############
#dddddddddd.....############
#@.........................#
############################
end
expect 1 static:Granite >= 136
explode 5 12 -3 0.25
expect 6 static:Dirt < 56        // of 60 dirt tiles, a good part is gone or loose
expect 6 static:Granite >= 136   // granite: untouched
