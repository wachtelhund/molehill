end
site 1 fossil -147 -59
hold 2-546 left up
hold 30-38 jump
hold 70-78 jump
hold 110-118 jump
hold 150-158 jump
hold 190-198 jump
hold 230-238 jump
hold 270-278 jump
hold 310-318 jump
hold 350-358 jump
hold 390-398 jump
hold 430-438 jump
hold 470-478 jump
hold 510-518 jump
hold 547-566 left
hold 570-760 down
hold 770-900 left
expect 450 py < 50                 // up on the ribs
expect 450 hp == 100
expect 566 ladder_down == 1        // at the rope's head on the mound's west end
expect 572 climbing == 1
expect 650 py == 68                // down on the floor...
expect 650 chests == 1             // ...and the chest is opened
expect 900 hp == 100               // the whole way unhurt
expect 900 deaths == 0
expect 900 debris == 0             // nothing came down
expect 900 crumbled == 0
