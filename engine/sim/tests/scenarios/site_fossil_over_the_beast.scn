end
site 1 fossil -147 -59
give RopeGun 1
give HookRope 40
fireby 2 -1 -40
hold 2-26 left
hold 27-191 left up
hold 192-195 left jump
hold 196-201 left
fireby 202 -1 -40
hold 202-226 left
hold 227-391 left up
hold 392-395 left jump
hold 396-401 left
fireby 402 -1 -40
hold 402-426 left
hold 427-591 left up
hold 592-595 left jump
hold 596-601 left
fireby 602 -1 -40
hold 602-626 left
hold 627-791 left up
hold 792-795 left jump
hold 796-801 left
hold 802-930 left                  // west over the ribs to the mound's west end
hold 934-1124 down
hold 1134-1264 left
expect 800 py < 50                 // up on the ribs
expect 800 hp == 100
expect 932 ladder_down == 1        // at the rope ladder's head on the mound's west end
expect 940 climbing == 1
expect 1020 py == 68               // down on the floor...
expect 1020 chests == 1            // ...and the chest is opened
expect 1264 hp == 100              // the whole way unhurt
expect 1264 deaths == 0
expect 1264 debris == 0            // nothing came down
expect 1264 crumbled == 0
