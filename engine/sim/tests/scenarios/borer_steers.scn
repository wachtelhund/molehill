end
give SteamBorer 1
give Coal 4
hold 1-1 right
place 2 5 0 SteamBorer
wield 10 Coal
use 11 5 -2
use 12 5 -2
use 13 5 -2
wield 14 none
use 15 5 -2                           // climb in
expect 16 onborer == 1
hold 300-420 right
expect 420 borerang == 0
expect 420 borery == 8                // bored straight east
expect 420 borerx > 24
hold 421-600 down
expect 430 borerang > 20              // swinging round toward down: a curve, not a snap
expect 430 borerang < 60
expect 450 borerang == 90             // heading straight down
expect 600 borery > 25                // and bored down
expect 600 borerx < 33
expect 600 borerv > 1.6               // at granite speed
hold 601-720 down right
expect 720 borerang > 44.5           // a diagonal
expect 720 borerang < 45.5
expect 720 borerx > 35
expect 720 borery > 38
hold 721-960 up
expect 760 borerang == 270            // turned back the short way (through east) and heading up
expect 960 borery < 16                // bored up
hold 961-1080 left
expect 1080 borerang == 180
expect 1080 borerx < 27               // and west, back over its first tunnel
expect 1080 onborer == 1
