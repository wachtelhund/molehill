end
give RopeGun 1
give HookRope 1
hold 1-45 right               // to the cliff's foot
fire 50 9 -31                 // straight up into the ceiling, just in front of the cliff
hold 86-100 up
expect 100 onrope == 1
expect 100 ropes == 1
hold 101-300 up right
expect 300 onrope == 0
expect 300 grounded == 1
expect 300 dy < -16
expect 300 dx > 12
expect 300 hp == 100
